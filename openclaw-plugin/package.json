{
  "name": "openclaw-plugin-agent-liaison",
  "version": "0.7.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts",
    "test:dependencies": "node --test test/dependency-compat.test.mjs"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/store.js",
    "dist/store.d.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "dependencies": {
    "typebox": "^1.4.5"
  },
  "devDependencies": {
    "openclaw": "2026.9.4",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4"
    }
  },
  "overrides": {
    "openclaw@2026.9.4": {
      "@modelcontextprotocol/sdk": "1.32.1",
      "undici": "8.12.2",
      "minimatch": "11.0.5",
      "zod": "4.6.7"
    }
  }
}
