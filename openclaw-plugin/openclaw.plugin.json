{
  "id": "agent-liaison",
  "name": "Agent Liaison",
  "description": "Coordinate bounded candidate-time proposals and owner decisions.",
  "version": "0.3.0",
  "configSchema": {
    "type": "object",
    "required": [
      "ownerSessionKey",
      "allowedRequesterSessionKeys"
    ],
    "properties": {
      "ownerSessionKey": {
        "type": "string"
      },
      "allowedRequesterSessionKeys": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "request_candidate_times",
      "check_candidate_status",
      "record_owner_scheduling_decision"
    ]
  },
  "toolMetadata": {
    "request_candidate_times": {
      "optional": true
    },
    "check_candidate_status": {
      "optional": true
    },
    "record_owner_scheduling_decision": {
      "optional": true
    }
  }
}
