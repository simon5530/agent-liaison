{
  "id": "agent-liaison",
  "name": "Agent Liaison",
  "description": "Expose bounded scheduling availability to an allowlisted Guest session.",
  "version": "0.2.0",
  "configSchema": {
    "type": "object",
    "required": [
      "ownerSessionKey",
      "allowedRequesterSessionKeys"
    ],
    "properties": {
      "ownerSessionKey": {
        "type": "string"
      },
      "allowedRequesterSessionKeys": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "googleCalendar": {
        "type": "object",
        "required": [
          "clientId",
          "clientSecret",
          "refreshToken"
        ],
        "properties": {
          "clientId": {
            "type": "string",
            "minLength": 1
          },
          "clientSecret": {
            "type": "string",
            "minLength": 1
          },
          "refreshToken": {
            "type": "string",
            "minLength": 1
          },
          "calendarId": {
            "type": "string",
            "minLength": 1,
            "default": "primary"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "request_synthetic_availability",
      "request_readonly_availability"
    ]
  },
  "toolMetadata": {
    "request_synthetic_availability": {
      "optional": true
    },
    "request_readonly_availability": {
      "optional": true
    }
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [
        { "path": "googleCalendar.clientId", "expected": "string", "ownerKind": "capability" },
        { "path": "googleCalendar.clientSecret", "expected": "string", "ownerKind": "capability" },
        { "path": "googleCalendar.refreshToken", "expected": "string", "ownerKind": "capability" }
      ]
    }
  }
}
